# Copy to .env.dev (gitignored). Read by the Vite dev/preview server for /api/voice/*.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Google AI Studio key: Gemini writes the short reply and Gemini 3.5 Transcribe hears the child.
# GOOGLE_API_KEY works as a fallback.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
# Speech-to-text: google (Gemini 3.5 Transcribe, default) or elevenlabs (Scribe)
VOICE_STT_PROVIDER=google
# Key for Gemini 3.5 Transcribe. Leave empty to reuse GOOGLE_AI_API_KEY.
GOOGLE_STT_API_KEY=
GOOGLE_STT_MODEL=gemini-3.5-transcribe
# verbatim keeps the child's exact words (default); smart removes fillers and adds punctuation
GOOGLE_STT_MODE=verbatim

# ElevenLabs: text-to-speech (and Scribe when VOICE_STT_PROVIDER=elevenlabs). The reply is read
# in the same voice and model as the recorded narration (Lulu Lolipop, Eleven v4).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=ocZQ262SsZb9RIxcQBOj
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v2
# Zero-retention transcription (enable_logging=false). Enterprise/trial tiers only; leave off otherwise.
ELEVENLABS_ZERO_RETENTION=

# Extra origins allowed to call the API (comma-separated). The site itself, the Capacitor
# WebView (https://localhost, capacitor://localhost) and local Vite ports are always allowed.
VOICE_ALLOWED_ORIGINS=

# Client side (optional): where the browser calls the API. Default is same-origin /api/voice.
# For the Android build put the deployed site here, e.g. https://maumlink.vercel.app/api/voice
VITE_VOICE_API_BASE=
