{
  "name": "maumlink",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm validate && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "build:native": "pnpm validate && tsc -b && vite build --mode native && cap sync android",
    "android:apk": "pnpm build:native && cd android && ./gradlew assembleDebug",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "validate": "node --import tsx scripts/validate-content.ts",
    "fonts": "uv run --quiet scripts/build-fonts.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chrome",
    "narration:inventory": "node --import tsx scripts/narration-inventory.ts",
    "brand": "uv run scripts/build-brand.py && pnpm app-icons",
    "app-icons": "node --import tsx scripts/build-app-icons.ts",
    "narration:import": "node --import tsx scripts/narration-import.ts",
    "narration:generate:clova": "node --import tsx scripts/narration-generate-clova.ts",
    "art:generate": "node --import tsx scripts/gen-art-codex.ts",
    "art:build": "node --import tsx scripts/build-art.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3"
  }
}
